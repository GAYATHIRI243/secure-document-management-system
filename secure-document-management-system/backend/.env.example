# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/sdms

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# Risk thresholds (points)
RISK_FAILED_LOGIN=10
RISK_MULTIPLE_FAILED_LOGIN=25
RISK_UNAUTHORIZED_ACCESS=30
RISK_EXCESSIVE_DOWNLOAD=20
RISK_RAPID_ACTIONS=15

# Multiple failed login window
FAILED_LOGIN_WINDOW_MINUTES=15
FAILED_LOGIN_THRESHOLD=3

# Excessive download window
DOWNLOAD_WINDOW_MINUTES=10
DOWNLOAD_THRESHOLD=5

# Rapid action window
RAPID_ACTION_WINDOW_SECONDS=30
RAPID_ACTION_THRESHOLD=6

# ML anomaly detection microservice (Isolation Forest + One-Class SVM)
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_MS=2000
# Extra risk points added when the ML service flags a combined anomaly
RISK_ML_ANOMALY=20
